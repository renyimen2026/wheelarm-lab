      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>1.8</length></cylinder></geometry><material><ambient>0.50 0.52 0.52 1</ambient><diffuse>0.50 0.52 0.52 1</diffuse></material></visual>
