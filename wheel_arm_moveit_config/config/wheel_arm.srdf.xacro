<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_arm">
  <xacro:arg name="camera_mount" default="low"/>
  <xacro:include filename="wheel_arm.srdf"/>
  <xacro:if value="${xacro.arg('camera_mount') == 'mast'}">
    <disable_collisions link1="base_link" link2="camera_mast_link" reason="Adjacent"/>
    <disable_collisions link1="camera_mast_link" link2="camera_link" reason="Adjacent"/>
  </xacro:if>
</robot>
